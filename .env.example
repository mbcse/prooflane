# Database (used by apps/api and Prisma CLI — not by the Next.js UI)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openagents"

# NextAuth (apps/web) — generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# GitHub OAuth (optional: "Continue with GitHub" on login + Vercel-style repo picker on /integrations/github)
# Create: https://github.com/settings/developers — OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
# The app requests scope: read:user user:email repo (users must approve repo access to list private repos)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Shared with apps/api POST /v1/auth/github/provision (openssl rand -hex 32)
INTERNAL_OAUTH_PROVISION_SECRET=""

# Backend API (apps/api) — same secret as AUTH_SECRET is fine for signing JWTs
JWT_SECRET=""
# Browser → API (must match where the Express server listens)
NEXT_PUBLIC_API_URL="http://127.0.0.1:4000"
# Server-side Next.js → API (optional; defaults to NEXT_PUBLIC_API_URL)
INTERNAL_API_URL="http://127.0.0.1:4000"

# 0G Storage (Galileo testnet) — https://docs.0g.ai/developer-hub/building-on-0g/storage/sdk
ZERO_G_EVM_RPC="https://evmrpc-testnet.0g.ai"
ZERO_G_INDEXER_RPC="https://indexer-storage-testnet-turbo.0g.ai"
# Fund wallet via https://faucet.0g.ai
ZERO_G_STORAGE_PRIVATE_KEY=""
# Optional: set to 1 to print SDK indexer sync poll lines (noisy; default off).
# ZERO_G_VERBOSE_STORAGE=1
# Upload waits on indexer sync; cap wait so compliance runs still finish (default 180000 ms). Use 0 to disable cap.
# ZERO_G_STORAGE_UPLOAD_TIMEOUT_MS=180000

# 0G Compute (testnet) — follow https://build.0g.ai/compute/#quickstart
# Fund wallet: https://faucet.0g.ai — quickstart needs ~3 OG ledger deposit + transfer to provider.
# Automate: npm run 0g:compute-setup  (uses OG_COMPUTE_PRIVATE_KEY or ZERO_G_STORAGE_PRIVATE_KEY)
# Then merge `.env.0g.compute.generated` into this file.
ZG_RPC_ENDPOINT="https://evmrpc-testnet.0g.ai"
OG_COMPUTE_PRIVATE_KEY=""
OG_COMPUTE_PROVIDER="0xa48f01287233509FD694a22Bf840225062E67836"
OG_COMPUTE_DEPOSIT_AMOUNT="3"
OG_COMPUTE_TRANSFER_AMOUNT="1"
# If you already ran deposit / transfer / ack, skip steps: OG_COMPUTE_SKIP_DEPOSIT=1 etc.
# OG_COMPUTE_SKIP_DEPOSIT=1
# OG_COMPUTE_SKIP_TRANSFER=1
# OG_COMPUTE_SKIP_ACK=1
ZG_COMPUTE_SERVICE_URL=""
ZG_COMPUTE_API_SECRET=""
ZG_COMPUTE_MODEL="qwen/qwen-2.5-7b-instruct"

# Legacy Router (optional if not using ZG_COMPUTE_* above)
OG_ROUTER_API_KEY=""
OG_ROUTER_BASE_URL="https://router-api-testnet.integratenetwork.work/v1"
OG_ROUTER_MODEL=""

# Optional debug
INTERNAL_AI_DEBUG_SECRET=""
